{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TVD2100/sagaai-marketplace/schema/entity.schema.json",
  "title": "SagaAI marketplace entity manifest",
  "description": "One published version of one catalog entity. The manifest describes the package byte-for-byte where a package exists: files[] and package.sha256 are what the platform verifies before installing anything. The package blocks are conditional by type - a skill and an agent always ship one, a RAG base may be served as a prebuilt index instead, and an MCP entity is a preset with no package at all.",
  "type": "object",
  "required": [
    "schema",
    "type",
    "id",
    "version",
    "name",
    "description",
    "license"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "sagaai.marketplace.entity/1"
    },
    "type": {
      "enum": [
        "agent",
        "skill",
        "rag",
        "mcp"
      ]
    },
    "agent_kind": {
      "enum": [
        "orchestrator",
        "assistant"
      ],
      "description": "Agents only: an employee (orchestrator, instructions folder) or a helper (assistant, prompt profile). Absent means orchestrator."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Catalog id; becomes a path component, hence the restricted charset."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "$ref": "#/$defs/localized"
    },
    "description": {
      "$ref": "#/$defs/localized_long"
    },
    "author": {
      "$ref": "#/$defs/localized"
    },
    "icon": {
      "type": "string",
      "maxLength": 16
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 32
      },
      "maxItems": 32
    },
    "license": {
      "type": "object",
      "required": [
        "spdx"
      ],
      "additionalProperties": true,
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "$ref": "#/$defs/localized"
        },
        "acceptance_required": {
          "type": "boolean",
          "default": false
        },
        "url": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "string"
        },
        "max": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executes_code": {
          "type": "boolean"
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "requires_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "description": "Relative path to the sha256 of its content. Generated by the publisher. Required for skill and agent; a prebuilt-index RAG base ships no package and therefore no files block.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "package": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "additionalProperties": true,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The downloadable package: url relative to the catalog root, its sha256 and its size in bytes. Generated by the publisher. Required for skill and agent; absent on mcp and on a RAG base served as a prebuilt index."
    },
    "distribution": {
      "type": "object",
      "description": "RAG bases only, and required for them: how the base is served - a prebuilt index, sources, or both. prebuilt_index declares index_url, index_sha256 and index_schema; a vector base also declares embedding_model.",
      "additionalProperties": true
    },
    "recommends": {
      "$ref": "#/$defs/members"
    },
    "bundle": {
      "$ref": "#/$defs/members"
    },
    "preset": {
      "type": "object",
      "description": "MCP entities only, and required for them: the connector preset the install creates. The whole entity is this block, which is why an mcp manifest carries no package.",
      "required": [
        "config"
      ],
      "additionalProperties": true,
      "properties": {
        "protocol_version": {
          "type": "string"
        },
        "protocol_compat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": [
                "string",
                "null"
              ]
            },
            "max": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "memory_seed": {
          "type": "string",
          "maxLength": 20000
        },
        "config": {
          "type": "object",
          "description": "Transport config without credentials; credentials are declared, never carried.",
          "additionalProperties": true
        }
      }
    },
    "source_url": {
      "type": "string",
      "maxLength": 500
    },
    "key_id": {
      "type": "string",
      "maxLength": 64
    },
    "signature": {
      "type": "string",
      "maxLength": 256
    }
  },
  "$defs": {
    "localized": {
      "description": "A short localized text: a bare string or an object keyed by language, en required. For names and author names.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          },
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "type": {
                "enum": [
                  "agent",
                  "skill",
                  "rag",
                  "mcp",
                  ""
                ]
              },
              "version": {
                "type": "string"
              },
              "default_selected": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "localized_long": {
      "description": "A long localized text: a bare string or an object keyed by language, en required. Descriptions carry the longer cap because a card needs a full sentence, not a label.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          },
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "skill",
              "agent"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "files",
          "package"
        ],
        "properties": {
          "files": {
            "minProperties": 1
          },
          "package": {
            "required": [
              "url",
              "sha256",
              "size"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rag"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "distribution"
        ],
        "properties": {
          "distribution": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "prebuilt_index",
                  "sources_only",
                  "sources_plus_index"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mcp"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "preset"
        ],
        "properties": {
          "preset": {
            "required": [
              "config"
            ]
          }
        }
      }
    }
  ]
}
