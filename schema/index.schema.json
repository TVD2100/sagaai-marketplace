{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TVD2100/sagaai-marketplace/schema/index.schema.json",
  "title": "SagaAI marketplace catalog index",
  "description": "The showcase the platform reads on every render: one summary per entity. Generated by the publisher, never edited by hand; index.json.sig signs exactly this document.",
  "type": "object",
  "required": ["schema", "updated_at", "entities"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "sagaai.marketplace.index/1"},
    "channel": {"type": "string", "maxLength": 32},
    "updated_at": {"type": "string", "minLength": 10},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "version", "path"],
        "additionalProperties": true,
        "properties": {
          "type": {"enum": ["agent", "skill", "rag", "mcp"]},
          "agent_kind": {"enum": ["orchestrator", "assistant"]},
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 300},
          "name": {"type": ["string", "object"]},
          "description": {"type": ["string", "object"]},
          "author": {"type": ["string", "object"]},
          "icon": {"type": "string", "maxLength": 16},
          "tags": {"type": "array", "items": {"type": "string", "maxLength": 32}},
          "license": {"type": "object"},
          "platform": {"type": "object"}
        }
      }
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "name": {"type": "string", "maxLength": 200},
          "path": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    }
  }
}
