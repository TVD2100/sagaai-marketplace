{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TVD2100/sagaai-marketplace/schema/bundle.schema.json",
  "title": "SagaAI marketplace bundle",
  "description": "A curated set of entities pinned to exact versions, so installing the set reproduces the same state on every machine.",
  "type": "object",
  "required": ["schema", "id", "name", "version", "items"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "sagaai.marketplace.bundle/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "name": {"type": ["string", "object"]},
    "description": {"type": ["string", "object"]},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"},
    "updated_at": {"type": "string", "minLength": 10},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "id", "version"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["agent", "skill", "rag", "mcp"]},
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
            "description": "Exact version, not a range: a bundle is reproducible."
          },
          "default_selected": {"type": "boolean", "default": true}
        }
      }
    }
  }
}
